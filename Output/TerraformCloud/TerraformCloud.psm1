        @{
            type = "policies"
            id = $_
        }
    }

    $body = @{
        data = $relationships
    } | ConvertTo-Json -Depth 10

    if ($PSCmdlet.ShouldProcess("Policy Set '$PolicySetId'", "Add policies")) {
