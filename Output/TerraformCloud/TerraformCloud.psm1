    )

    $attributes = @{
        description = $Description
    }

    if ($ExpiredAt) {
        $attributes['expired-at'] = $ExpiredAt
    }

    $body = @{
        data = @{
            type = "authentication-tokens"
            attributes = $attributes
        }
    } | ConvertTo-Json -Depth 10

